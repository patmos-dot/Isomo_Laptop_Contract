# Copy this file to .env and fill in the values. Never commit .env.

# Folder for the roster, the database, signed PDFs, and email previews. Must be outside this repository.
# On the server, use a full path, for example C:\IsomoContracts\data
DATA_DIR=../isomo-contract-data

# Roster CSV. Leave empty on the server to use DATA_DIR/roster.csv.
# For local testing, point it at the made-up roster:
ROSTER_FILE=test-data/roster.example.csv

# The web page. Keep HOST=127.0.0.1 so the page is reachable only through Cloudflare Tunnel.
HOST=127.0.0.1
PORT=3000
# The address scholars see in their link. On the server: the Cloudflare Tunnel address.
PUBLIC_BASE_URL=http://localhost:3000
# How many days a signing link works.
LINK_VALID_DAYS=14

# Email. preview = send nothing and save each email as a .eml file in DATA_DIR/outbox.
#        smtp    = send for real.
MAIL_MODE=preview
MAIL_FROM=Isomo <isomoadmin@bridge2rwanda.org>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# For Gmail, use an app password, not the account password.
SMTP_PASS=
# While testing, every email goes to this one address (the one the owner names).
MAIL_TEST_RECIPIENT=
# Set to yes only after the owner approves sending to real scholars.
MAIL_SEND_TO_SCHOLARS=no

# Optional: use an installed Chrome instead of the one Puppeteer downloads.
CHROME_PATH=
